/* SOS Apollo · Relatório de Emergência (dark, the person's own view) and Modo Médico (paper, print-first A4).
   Colour never carries meaning alone: every tinted block also prints its text tag (WCAG 1.4.1, black-and-white print). */
* { box-sizing: border-box; }
html, body { margin: 0; }
button { font: inherit; }
.hidden { display: none !important; }
:focus-visible { outline: 2px solid #5b8def; outline-offset: 2px; }

/* ── toolbar (screen only) ── */
.toolbar { position: sticky; top: 0; z-index: 50; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 12px; background: rgba(16, 24, 40, .96); border-bottom: 1px solid rgba(255,255,255,.12); }
.tb-btn { appearance: none; display: inline-flex; align-items: center; min-height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid #475467; background: #1d2939; color: #fff; text-decoration: none; font-size: 14px; cursor: pointer; }
.tb-btn.primary { background: #fff; color: #101828; border-color: #fff; }
.tb-status { flex: 1 1 160px; display: inline-flex; align-items: center; gap: 8px; color: #d0d5dd; font-size: 13px; }
.tb-status .dot { width: 8px; height: 8px; border-radius: 50%; background: #32d583; box-shadow: 0 0 0 4px rgba(50,213,131,.18); animation: live 2s ease-in-out infinite; }
@keyframes live { 50% { box-shadow: 0 0 0 1px rgba(50,213,131,.1); } }
.scenario { display: inline-flex; align-items: center; gap: 6px; color: #d0d5dd; font-size: 13px; }
.scenario select { min-height: 36px; max-width: 60vw; border-radius: 8px; border: 1px solid #475467; background: #1d2939; color: #fff; font: inherit; }
.channel { margin: 10px auto; max-width: 210mm; padding: 0 12px; font-size: 12px; color: #667085; text-align: center; }
.waiting { max-width: 520px; margin: 40px auto; padding: 24px; display: grid; justify-items: center; gap: 14px; text-align: center; font-size: 15px; line-height: 1.5; }
.waiting .pulse { width: 14px; height: 14px; border-radius: 50%; background: #5b8def; animation: live 1.6s ease-in-out infinite; }
.empty { color: #667085; font-size: 9pt; margin: 1mm 0; }

/* ═══ MODO MÉDICO — app screen (tokens do core.js) + paper print ═══
   Nunca redeclara :root. Aliases clínicos só no escopo da página.
   Von Restorff: um único acento na tela (Copiar resumo). Close fecha, nunca volta. */
.page-medico {
  --ink: var(--txt-heading, #101828);
  --soft: var(--surface, #f7f8fa);
  --line: rgba(var(--rgb-diff, 10, 10, 10), .12);
  --line-2: rgba(var(--rgb-diff, 10, 10, 10), .06);
  --paper: var(--card, #fff);
  --screen: var(--bg, #f9f8f8);
  --red: var(--alert-red, #b42318);
  --red-bg: var(--alert-card, #fff1f0);
  --amber: var(--orange-700, #9a6700);
  --amber-bg: rgba(var(--rgb-accent, 255, 170, 51), .12);
  --blue: var(--txt-heading, #175cd3);
  --blue-bg: var(--surface, #eff6ff);
  --violet: var(--txt-heading, #5925dc);
  --violet-bg: var(--surface, #f4f0ff);
  background: var(--bg);
  color: var(--txt-color);
  font-family: var(--ff-main, Arial, Helvetica, sans-serif);
  font-size: var(--fs-p, 10pt);
  line-height: 1.32;
  min-height: 100dvh;
  -webkit-font-smoothing: antialiased;
  overscroll-behavior: none;
  padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px));
}
.page-medico #apollo-suporte-root,
.page-medico #apollo-sb-x,
.page-medico #apollo-sb-y { display: none !important; }

.page-medico .toolbar.ax-top {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 9901;
  height: auto;
  min-height: 56px;
  padding: calc(6px + var(--safe-top, env(safe-area-inset-top, 0px))) 10px 8px;
  background: transparent;
  border: 0;
  flex-wrap: nowrap;
  gap: 6px;
}
.page-medico .ax-top-l { min-width: 0; }
.page-medico .ax-top-wm { font-size: calc(var(--fs-r, 1) * 15px); letter-spacing: -.01em; }
.page-medico .ax-top-logo {
  background: var(--black-1);
  color: var(--bg);
}
.page-medico .tb-status {
  flex: 1 1 auto; min-width: 0;
  color: var(--muted);
  font: 500 calc(var(--fs-r, 1) * 10px)/1.3 var(--ff-mono, ui-monospace, monospace);
  letter-spacing: .06em; text-transform: uppercase;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.page-medico .tb-status .dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--accent); flex-shrink: 0;
  box-shadow: 0 0 0 4px rgba(var(--rgb-accent, 255, 170, 51), .18);
}
.page-medico .scenario,
.page-relatorio .scenario {
  display: flex;
  align-items: center;
  gap: 8px;
  width: min(100% - 28px, 480px);
  margin: 8px auto 0;
  color: var(--muted);
  font: 500 calc(var(--fs-r, 1) * 10px)/1.3 var(--ff-mono, ui-monospace, monospace);
  letter-spacing: .08em;
  text-transform: uppercase;
}
.page-medico .scenario.hidden,
.page-relatorio .scenario.hidden { display: none !important; }
.page-medico .scenario select,
.page-relatorio .scenario select {
  flex: 1;
  min-height: 40px;
  min-width: 0;
  max-width: none;
  border-radius: var(--r-sm, 12px);
  border: 1px solid rgba(var(--rgb-diff), .04);
  background: var(--surface);
  color: var(--txt-heading);
  font: inherit;
  padding: 0 12px;
  box-shadow: inset 0 1px 0 0 rgba(var(--rgb-theme), .9), inset 0 0 0 1px rgba(var(--rgb-theme), .4);
}
.page-medico .ax-ic,
.page-relatorio .ax-ic {
  width: 44px; height: 44px; min-width: 44px;
  color: var(--txt-heading);
  background: var(--surface);
}
.page-medico .ax-ic svg,
.page-relatorio .ax-ic svg { display: block; }

/* Von Restorff: dock. Só a CTA principal usa accent. */
.page-medico .medico-dock,
.page-relatorio .medico-dock {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 9901;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 6px;
  padding: 8px 12px calc(10px + env(safe-area-inset-bottom, 0px));
  background: linear-gradient(to top, rgba(var(--rgb-theme), 1) 58%, rgba(var(--rgb-theme), 0));
}
.page-medico .medico-dock .btn,
.page-relatorio .medico-dock .btn { width: 100%; min-height: 48px; }
.page-medico .medico-dock .btn-accent,
.page-relatorio .medico-dock .btn-accent {
  box-shadow: none;
  isolation: isolate;
}

/* Relatório: ações só no topo (ícones). Sem dock inferior. */
.page-relatorio .medico-dock,
.page-relatorio .report-dock { display: none !important; }
.page-relatorio .ax-top-r {
  display: flex;
  align-items: center;
  gap: 2px;
  flex: none;
}
.page-relatorio .ax-ic {
  width: 36px; height: 36px; min-width: 36px;
}
.page-relatorio .ax-ic i,
.page-medico .ax-ic i,
.page-relatorio .ax-ic [class^="ri-"],
.page-medico .ax-ic [class^="ri-"] {
  font-size: 18px;
  line-height: 1;
  display: block;
  font-weight: 100 !important;
}
.page-relatorio .ax-ic[aria-pressed="true"] {
  background: var(--black-1);
  color: var(--bg);
}

.page-medico .channel {
  margin: 6px auto 0;
  max-width: 480px;
  padding: 0 16px;
  font-family: var(--ff-mono, ui-monospace, monospace);
  font-size: calc(var(--fs-r, 1) * 9px);
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--muted);
  text-align: center;
  opacity: .78;
}
.page-medico .channel a { color: var(--txt-heading); text-decoration: underline; text-underline-offset: 3px; }
.page-medico .waiting {
  color: var(--txt-heading);
  background: var(--card);
  border-radius: var(--r, 20px);
  box-shadow: inset 0 1px 0 0 rgba(var(--rgb-theme), .9), inset 0 0 0 1px rgba(var(--rgb-theme), .4);
  border: 1px solid rgba(var(--rgb-diff), .04);
}
.document { padding: 8px 0 12px; }
.sheet { position: relative; width: 210mm; min-height: 297mm; margin: 0 auto 14px; padding: 11mm 11mm 18mm; background: var(--paper); overflow: hidden; box-shadow: inset 0 1px 0 0 rgba(var(--rgb-theme, 249, 248, 248), .9), inset 0 0 0 1px rgba(var(--rgb-theme, 249, 248, 248), .4); border: 1px solid rgba(var(--rgb-diff, 10, 10, 10), .04); border-radius: var(--r, 20px); }
.page-medico .document { padding: 2px 12px 28px; }
@media screen {
  .page-medico .sheet {
    width: min(100%, 440px);
    min-height: auto;
    margin: 0 auto 10px;
    padding: 20px 16px 26px;
  }
  .page-medico .brandline {
    font-family: var(--ff-mono, ui-monospace, monospace);
    font-size: calc(var(--fs-r, 1) * 9px);
    letter-spacing: .14em;
  }
  .page-medico h1 {
    font-family: var(--ff-heading, var(--ff-main), system-ui, sans-serif);
    font-size: clamp(1.35rem, 5.2vw, 1.7rem);
    line-height: 1.02;
    letter-spacing: -.035em;
    color: var(--txt-heading);
  }
  .page-medico .subtitle {
    font-size: calc(var(--fs-r, 1) * 12px);
    line-height: 1.45;
  }
  .page-medico .scan {
    border-radius: var(--r-sm, 15px);
    padding: 12px 12px 13px;
    min-height: 0;
    border: 1px solid rgba(var(--rgb-diff), .06);
    box-shadow: inset 0 1px 0 0 rgba(var(--rgb-theme), .9), inset 0 0 0 1px rgba(var(--rgb-theme), .35);
  }
  .page-medico .scan .label {
    font-family: var(--ff-mono, ui-monospace, monospace);
    font-size: calc(var(--fs-r, 1) * 9px);
  }
  .page-medico .scan .value {
    font-size: calc(var(--fs-r, 1) * 15px);
    letter-spacing: -.02em;
  }
  .page-medico .section-title h2 {
    font-family: var(--ff-heading, var(--ff-main), system-ui, sans-serif);
    font-size: calc(var(--fs-r, 1) * 15px);
    letter-spacing: -.02em;
  }
}
.page-footer { position: absolute; left: 11mm; right: 11mm; bottom: 6mm; display: flex; justify-content: space-between; gap: 10px; padding-top: 2.4mm; border-top: .3mm solid var(--line-2); color: var(--muted); font-size: 7.5pt; }
.doc-head { display: grid; grid-template-columns: 1fr auto; gap: 12mm; align-items: start; border-bottom: .55mm solid var(--ink); padding-bottom: 4mm; margin-bottom: 4mm; }
.brandline { font-size: 8pt; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; color: var(--muted); margin-bottom: 1.3mm; }
.page-medico h1 { margin: 0; font-size: 19pt; line-height: 1.04; letter-spacing: -.02em; }
.subtitle { margin: 1.7mm 0 0; color: var(--muted); font-size: 9pt; }
.episode-box { min-width: 47mm; border-left: .8mm solid var(--ink); padding-left: 3mm; }
.episode-box .k { color: var(--muted); font-size: 7pt; text-transform: uppercase; letter-spacing: .09em; font-weight: 700; }
.episode-box .v { font-size: 10pt; font-weight: 700; margin-top: .6mm; }
.episode-box .sub { font-size: 7.5pt; color: var(--muted); margin-top: .5mm; }
.integrity { display: grid; grid-template-columns: auto 1fr; gap: 3mm; align-items: start; border: .35mm solid #b2ccff; background: var(--blue-bg); border-radius: 2.2mm; padding: 3mm 3.5mm; margin-bottom: 4mm; }
.integrity .badge { font-size: 7pt; text-transform: uppercase; letter-spacing: .08em; font-weight: 800; color: var(--blue); white-space: nowrap; }
.integrity strong { font-size: 9pt; }
.integrity p { margin: .6mm 0 0; color: #344054; font-size: 8pt; }
.p0-banner { border: .5mm solid var(--red); background: var(--red-bg); color: #7a271a; border-radius: 2.4mm; padding: 3mm 3.5mm; margin: 0 0 4mm; }
.p0-banner b { display: block; color: var(--red); font-size: 8pt; letter-spacing: .08em; }
.p0-banner p { margin: 1mm 0 0; font-size: 10pt; font-weight: 700; }
.section { margin-top: 4mm; break-inside: avoid; }
.section.first { margin-top: 0; }
.section-title { display: flex; align-items: flex-end; justify-content: space-between; gap: 8mm; border-bottom: .35mm solid var(--line); padding-bottom: 1.3mm; margin-bottom: 2.3mm; }
.section-title h2 { margin: 0; font-size: 10.7pt; letter-spacing: .01em; }
.section-title span { color: var(--muted); font-size: 7.3pt; text-align: right; }
.scan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.2mm; }
.scan-grid.flags { grid-template-columns: repeat(4, 1fr); margin-top: 2.2mm; }
.scan { border: .35mm solid var(--line); border-radius: 2.4mm; padding: 3mm; min-height: 20mm; break-inside: avoid; }
.scan .label { color: var(--muted); font-size: 7pt; text-transform: uppercase; letter-spacing: .07em; font-weight: 800; }
.scan .value { margin-top: 1.3mm; font-size: 11pt; line-height: 1.14; font-weight: 800; }
.flags .scan .value { font-size: 9pt; }
.scan .note { margin-top: 1.1mm; color: var(--muted); font-size: 7.3pt; }
.scan .tag-print { font-weight: 800; }
.scan.tone-reported { background: var(--blue-bg); border-color: #b2ccff; }
.scan.tone-attention { background: var(--amber-bg); border-color: #fedf89; }
.scan.tone-alert { background: var(--red-bg); border-color: #fda29b; }
.scan.tone-alert .value, .scan.tone-alert .tag-print { color: var(--red); }
.scan.tone-unknown { background: #f9fafb; border-color: var(--line-2); border-style: dashed; }
.scan.tone-unknown .value { color: #475467; font-size: 9pt; letter-spacing: .04em; }
.exposure, .source-table, .signal-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
.exposure th, .source-table th, .signal-table th { text-align: left; color: var(--muted); font-size: 6.8pt; text-transform: uppercase; letter-spacing: .05em; border-bottom: .35mm solid var(--line); padding: 1.6mm 1.5mm; }
.exposure td { vertical-align: top; border-bottom: .3mm solid var(--line-2); padding: 2.2mm 1.5mm; font-size: 8.2pt; }
.source-table td, .signal-table td { padding: 1.5mm; border-bottom: .3mm solid var(--line-2); font-size: 7.3pt; vertical-align: top; }
.exposure tr:last-child td, .source-table tr:last-child td, .signal-table tr:last-child td { border-bottom: 0; }
.signal-table code { font-family: "Courier New", monospace; font-size: 7pt; }
.signal-table tr.tone-unknown td { color: #7a5d00; }
.signal-table tr.tone-attention .st { color: var(--amber); font-weight: 800; }
.tag { display: inline-block; border-radius: 99px; padding: .8mm 1.8mm; font-size: 6.7pt; font-weight: 800; letter-spacing: .03em; }
.tag.reported { background: #dbeafe; color: #1849a9; }
.tag.unknown { background: #f2f4f7; color: #475467; }
.tag.derived { background: var(--violet-bg); color: var(--violet); }
.mix-alerts { display: grid; grid-template-columns: 1fr 1fr; gap: 2mm; margin-top: 2.4mm; }
.mix { border: .35mm solid #fedf89; background: var(--amber-bg); border-radius: 2.4mm; padding: 2.7mm 3mm; }
.mix small { display: block; color: var(--amber); text-transform: uppercase; font-weight: 800; letter-spacing: .06em; font-size: 6.7pt; }
.mix strong { display: block; margin-top: 1mm; font-size: 8.7pt; }
.mix p { margin: .9mm 0 0; color: #5f4a16; font-size: 7.2pt; }
.handoff-box { background: var(--black-1, #101828); color: var(--bg, #fff); border-radius: var(--r-sm, 2.6mm); padding: 3.5mm 4mm; }
.handoff-box .label { color: rgba(var(--rgb-theme, 249, 248, 248), .55); font-size: 6.8pt; text-transform: uppercase; letter-spacing: .09em; font-weight: 800; }
.handoff-box p { margin: 1.3mm 0 0; font-size: 9pt; line-height: 1.38; }
@media screen {
  .page-medico .handoff-box {
    background: var(--black-1);
    color: var(--bg);
    border-radius: var(--r);
    padding: 16px 16px 18px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .page-medico .handoff-box .label { font-size: calc(var(--fs-r, 1) * 10px); color: rgba(var(--rgb-theme), .6); }
  .page-medico .handoff-box p { font-size: calc(var(--fs-r, 1) * var(--fs-p2, 14px)); }
}
.meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2mm; }
.meta { border: .3mm solid var(--line-2); background: var(--soft); border-radius: 2.2mm; padding: 2.5mm 3mm; }
.meta .k { color: var(--muted); font-size: 6.8pt; text-transform: uppercase; letter-spacing: .06em; font-weight: 800; }
.meta .v { margin-top: .8mm; font-size: 8pt; font-weight: 700; }
.sensitive { margin: 4mm 0 0; font-size: 7.4pt; color: #344054; border-left: .8mm solid var(--violet); padding-left: 2.5mm; }
.timeline { list-style: none; padding: 0; margin: 0; }
.timeline li { display: grid; grid-template-columns: 20mm 1fr 28mm; gap: 3mm; align-items: start; padding: 1.8mm 0; border-bottom: .3mm solid var(--line-2); break-inside: avoid; }
.timeline li:last-child { border-bottom: 0; }
.timeline .time { font-family: "Courier New", monospace; font-size: 7.7pt; font-weight: 700; color: #344054; }
.timeline .time small { display: block; font-weight: 400; color: var(--muted); }
.tl-main strong { display: block; font-size: 8.5pt; }
.tl-state { text-align: right; font-size: 6.8pt; color: var(--muted); }
.timeline li.tone-alert .tl-main strong { color: var(--red); }
.timeline li.tone-attention .tl-main strong { color: var(--amber); }
.timeline li.tone-derived .tl-main strong { color: #475467; font-weight: 400; }
.care-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8mm; }
.care { border: .3mm solid var(--line-2); border-radius: 2mm; padding: 2.3mm 2.7mm; break-inside: avoid; }
.care-head { display: flex; justify-content: space-between; gap: 3mm; align-items: start; }
.care strong { font-size: 8pt; }
.care p { margin: .8mm 0 0; color: var(--muted); font-size: 7pt; }
.out { font-size: 6.7pt; font-weight: 800; white-space: nowrap; }
.out-done { color: #067647; } .out-shown { color: var(--blue); } .out-failed { color: var(--amber); }
.statement { border: .4mm solid var(--red); background: var(--red-bg); color: #7a271a; border-radius: 2.4mm; padding: 3mm 3.5mm; font-size: 8pt; margin-top: 4mm; }
.tech-banner { border: .35mm solid #d6bbfb; background: var(--violet-bg); border-radius: 2.4mm; padding: 3mm 3.5mm; color: #3e1c96; margin-bottom: 4mm; font-size: 8pt; }
.risk-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.7mm; }
.risk-card { border: .3mm solid var(--line); border-radius: 2mm; padding: 2.2mm; }
.risk-card .name { color: var(--muted); font-size: 6.4pt; text-transform: uppercase; font-weight: 800; letter-spacing: .04em; }
.risk-card .score { font-size: 13pt; font-weight: 800; margin-top: .7mm; }
.risk-card .scale { color: var(--muted); font-size: 6.3pt; }
.guarantees { margin: 0; padding-left: 4mm; }
.guarantees li { margin: 1mm 0; font-size: 7.6pt; }
@page { size: A4 portrait; margin: 10mm 10mm 11mm; }
@media print {
  .page-medico, .page-medico html { background: #fff; color: #101828; }
  .page-medico { --ink: #101828; --muted: #667085; --soft: #f7f8fa; --line: #d7dde5; --line-2: #eaecf0; --paper: #fff; --red: #b42318; --red-bg: #fff1f0; --amber: #9a6700; --amber-bg: #fff8e6; --blue: #175cd3; --blue-bg: #eff6ff; --violet: #5925dc; --violet-bg: #f4f0ff; padding-bottom: 0; }
  .no-print, .toolbar, .medico-dock, .ax-top-blur { display: none !important; }
  .document { padding: 0; }
  .sheet { width: auto; min-height: auto; margin: 0; padding: 0 0 8mm; box-shadow: none; overflow: visible; break-after: page; }
  .sheet:last-child { break-after: auto; }
  .page-footer { position: static; margin-top: 5mm; }
  table { break-inside: auto; } tr { break-inside: avoid; }
  thead { display: table-header-group; }
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
}
@media (max-width: 900px) {
  .sheet { width: calc(100% - 16px); min-height: auto; padding: 16px 14px 44px; }
  .page-medico .sheet { width: min(100%, 480px); padding: 18px 16px 28px; }
  .doc-head { grid-template-columns: 1fr; gap: 10px; }
  .scan-grid, .scan-grid.flags { grid-template-columns: 1fr 1fr; }
  .mix-alerts, .care-grid, .meta-grid { grid-template-columns: 1fr; }
  .risk-grid { grid-template-columns: 1fr 1fr; }
  .timeline li { grid-template-columns: 17mm 1fr; }
  .tl-state { grid-column: 2; text-align: left; }
  .exposure th:nth-child(3), .exposure td:nth-child(3) { display: none; }
}
@media screen and (max-width: 540px) {
  .page-medico .tb-status { display: none; }
  .page-medico .scan-grid,
  .page-medico .scan-grid.flags,
  .page-medico .risk-grid { grid-template-columns: 1fr; }
  .page-medico .scan.tone-alert {
    outline: 2px solid var(--alert-red);
    outline-offset: 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .page-medico .tb-status .dot,
  .page-medico .ax-dot { animation: none !important; }
}

/* ═══ RELATÓRIO — folhas A4 (hospital / médico). Sem 192. Von Restorff: 1 CTA. ═══ */
.page-relatorio {
  --ink: var(--txt-heading, #101828);
  --soft: var(--surface, #f7f8fa);
  --line: rgba(var(--rgb-diff, 10, 10, 10), .12);
  --line-2: rgba(var(--rgb-diff, 10, 10, 10), .07);
  --paper: #fff;
  --red: var(--alert-red, #b42318);
  --red-bg: var(--alert-card, #fff1f0);
  --amber: var(--orange-700, #9a6700);
  --a4-w: 210mm;
  --a4-h: 297mm;
  background: var(--bg);
  color: var(--txt-color);
  font-family: var(--ff-main, system-ui, sans-serif);
  font-size: 10.5pt;
  line-height: 1.38;
  min-height: 100dvh;
  -webkit-font-smoothing: antialiased;
  overscroll-behavior: none;
  padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
}
.page-relatorio.is-a4-expanded .a4-stage {
  padding-inline: 8px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.page-relatorio.is-a4-expanded .a4-pages {
  align-items: center;
  margin-inline: auto;
}
.page-relatorio #apollo-suporte-root,
.page-relatorio #apollo-sb-x,
.page-relatorio #apollo-sb-y { display: none !important; }

.page-relatorio .toolbar.ax-top {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 9901;
  height: auto;
  min-height: 48px;
  padding: calc(4px + var(--safe-top, env(safe-area-inset-top, 0px))) 10px 6px;
  background: transparent;
  border: 0;
  flex-wrap: nowrap;
  gap: 6px;
}
.page-relatorio .ax-top-l { min-width: 0; }
.page-relatorio .ax-top-wm { font-size: calc(var(--fs-r, 1) * 14px); letter-spacing: -.01em; }
.page-relatorio .ax-top-logo { background: var(--black-1); color: var(--bg); width: 18px; height: 18px; }
.page-relatorio .tb-status {
  flex: 1 1 auto; min-width: 0;
  color: var(--muted);
  font: 500 calc(var(--fs-r, 1) * 9px)/1.3 var(--ff-mono, ui-monospace, monospace);
  letter-spacing: .06em; text-transform: uppercase;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.page-relatorio .tb-status .dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--accent); flex-shrink: 0;
}
.page-relatorio .a4-pagecount {
  flex: none;
  font: 600 calc(var(--fs-r, 1) * 9px)/1 var(--ff-mono, ui-monospace, monospace);
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0 4px;
}
.page-relatorio .ax-ic {
  width: 36px; height: 36px; min-width: 36px;
}

/* Fonte oculta quando as folhas A4 estão montadas */
.page-relatorio.is-a4 .a4-source {
  position: absolute !important;
  width: 1px !important; height: 1px !important;
  margin: -1px !important; padding: 0 !important;
  overflow: hidden !important; clip: rect(0,0,0,0) !important;
  border: 0 !important; white-space: nowrap !important;
}
.page-relatorio .a4-stage {
  width: 100%;
  padding: 8px 12px 20px;
}
.page-relatorio .a4-pages {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  width: 100%;
}

/* Folha A4 — tamanho real fixo (794×1123 @96dpi). Escala via transform no JS. */
.page-relatorio .a4-page {
  position: relative;
  width: 794px;
  height: 1123px;
  flex: 0 0 auto;
  background: var(--paper);
  color: var(--ink);
  border-radius: 2px;
  box-shadow:
    0 1px 10px rgba(0, 0, 0, .08),
    0 0 0 1px rgba(0, 0, 0, .04);
  overflow: hidden;
  break-after: page;
  page-break-after: always;
  transform-origin: top center;
}
.page-relatorio .a4-page:last-child {
  break-after: auto;
  page-break-after: auto;
}
.page-relatorio .a4-page::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--black-1);
  z-index: 2;
  pointer-events: none;
}
.page-relatorio .a4-page__body {
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}
.page-relatorio .a4-page__foot {
  position: absolute;
  left: 52px; right: 52px; bottom: 18px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding-top: 8px;
  border-top: 1px solid var(--line-2);
  font: 500 8pt/1.2 var(--ff-mono, ui-monospace, monospace);
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--muted);
}

/* Fallback antes do paginator (sem JS / loading) */
.page-relatorio:not(.is-a4) .rel,
.page-relatorio:not(.is-a4) .document-pdf {
  width: min(100% - 24px, 794px);
  min-height: 1123px;
  margin: 10px auto 16px;
  padding: 48px 52px 56px;
  background: var(--paper);
  color: var(--ink);
  border-radius: 2px;
  border: 1px solid rgba(var(--rgb-diff), .06);
  box-shadow: 0 1px 10px rgba(0, 0, 0, .08);
}
.page-relatorio .waiting {
  color: var(--txt-heading);
  background: var(--card);
  border-radius: var(--r-sm, 15px);
  border: 1px solid rgba(var(--rgb-diff), .04);
  padding: 20px;
  text-align: center;
}

.page-relatorio .rel-head {
  padding-bottom: 12px;
  margin-bottom: 12px;
  border-bottom: 1.5px solid var(--ink);
}
.page-relatorio .rel-brand {
  margin: 0 0 6px;
  font: 700 8pt/1.3 var(--ff-mono, ui-monospace, monospace);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--muted);
}
.page-relatorio .rel-head h1 {
  margin: 0;
  font-family: var(--ff-heading, var(--ff-main), system-ui, sans-serif);
  font-size: 18pt;
  line-height: 1.05;
  letter-spacing: -.035em;
  font-weight: 700;
  color: var(--txt-heading);
}
.page-relatorio .rel-sub {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 9.5pt;
  line-height: 1.4;
  max-width: 48ch;
}
.page-relatorio .rel-times {
  margin: 12px 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: 4px 12px;
  font-family: var(--ff-mono, ui-monospace, monospace);
  font-size: 8.5pt;
  letter-spacing: .02em;
  color: var(--txt-color);
}
.page-relatorio .rel-elapsed {
  color: var(--txt-heading);
  font-weight: 700;
}

/* Von Restorff: P0 é o único bloco que grita */
.page-relatorio .p0-banner {
  margin: 0 0 12px;
  padding: 10px 12px;
  border-radius: 8px;
  background: var(--red-bg);
  border: 1.5px solid var(--red);
  color: #7a271a;
}
.page-relatorio .p0-banner b {
  display: block;
  font-family: var(--ff-mono, ui-monospace, monospace);
  font-size: 8pt;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--red);
  font-weight: 800;
}
.page-relatorio .p0-banner p {
  margin: 5px 0 0;
  font-size: 11pt;
  font-weight: 700;
  line-height: 1.28;
  color: #7a271a;
}

.page-relatorio .rel-block {
  margin-top: 12px;
  padding: 0;
  background: transparent;
  box-shadow: none;
  border: 0;
  border-radius: 0;
}
.page-relatorio .rel-block + .rel-block {
  padding-top: 12px;
  border-top: 1px solid var(--line-2);
}
.page-relatorio .rel-block h2 {
  margin: 0 0 8px;
  font-family: var(--ff-heading, var(--ff-main), system-ui, sans-serif);
  font-size: 11pt;
  letter-spacing: -.02em;
  font-weight: 700;
  color: var(--txt-heading);
}

.page-relatorio .rel-now {
  display: grid;
  grid-template-columns: minmax(100px, 34%) 1fr;
  gap: 5px 10px;
  margin: 0;
}
.page-relatorio .rel-now dt {
  color: var(--muted);
  font-family: var(--ff-mono, ui-monospace, monospace);
  font-size: 7.5pt;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding-top: 2px;
}
.page-relatorio .rel-now dd {
  margin: 0;
  color: var(--txt-heading);
  font-size: 10pt;
  font-weight: 650;
  letter-spacing: -.01em;
}

.page-relatorio .care-grid {
  display: grid;
  gap: 6px;
  grid-template-columns: 1fr 1fr;
}
.page-relatorio .care {
  padding: 8px 10px;
  border-radius: 8px;
  background: var(--soft);
  border: 1px solid rgba(var(--rgb-diff), .05);
}
.page-relatorio .care-head {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: start;
}
.page-relatorio .care strong {
  font-weight: 650;
  font-size: 9.5pt;
  color: var(--txt-heading);
}
.page-relatorio .care p {
  margin: 3px 0 0;
  font-size: 8pt;
  color: var(--muted);
  line-height: 1.35;
}
.page-relatorio .out {
  font-family: var(--ff-mono, ui-monospace, monospace);
  font-size: 7.5pt;
  letter-spacing: .05em;
  text-transform: uppercase;
  font-weight: 700;
  white-space: nowrap;
}
.page-relatorio .out-done { color: #067647; }
.page-relatorio .out-shown { color: var(--txt-heading); }
.page-relatorio .out-failed { color: var(--amber); }

.page-relatorio .timeline {
  list-style: none;
  margin: 0;
  padding: 0;
}
.page-relatorio .timeline li {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 8px;
  padding: 7px 0;
  border-bottom: 1px solid var(--line-2);
  break-inside: avoid;
  page-break-inside: avoid;
}
.page-relatorio .timeline li:last-child { border-bottom: 0; }
.page-relatorio .timeline .time {
  font: 600 8pt/1.3 var(--ff-mono, ui-monospace, monospace);
  color: var(--txt-heading);
  font-variant-numeric: tabular-nums;
}
.page-relatorio .timeline .time small {
  display: block;
  font-weight: 400;
  color: var(--muted);
}
.page-relatorio .tl-main strong {
  font-weight: 650;
  font-size: 9.5pt;
  color: var(--txt-heading);
}
.page-relatorio .tl-state {
  grid-column: 2;
  font-family: var(--ff-mono, ui-monospace, monospace);
  font-size: 7.5pt;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 1px;
}
.page-relatorio .timeline li.tone-alert .tl-main strong { color: var(--red); }
.page-relatorio .timeline li.tone-attention .tl-main strong { color: var(--amber); }
.page-relatorio .timeline li.tone-derived .tl-main strong { color: var(--muted); font-weight: 500; }
.page-relatorio .empty {
  color: var(--muted);
  font-size: 9.5pt;
  margin: 0;
}

.page-relatorio .rel-privacy {
  margin: 14px 0 0;
  padding-top: 10px;
  border-top: 1px solid var(--line-2);
  font-size: 8pt;
  line-height: 1.45;
  color: var(--muted);
}

.page-relatorio .rel-sos { display: none !important; }

@media screen and (max-width: 540px) {
  .page-relatorio .tb-status { display: none; }
  .page-relatorio .care-grid { grid-template-columns: 1fr; }
}

@page {
  size: A4 portrait;
  margin: 12mm 14mm 14mm;
}

@media print {
  .page-relatorio {
    background: #fff !important;
    color: #101828 !important;
    padding: 0 !important;
    --ink: #101828;
    --muted: #667085;
    --soft: #f7f8fa;
    --line: #d7dde5;
    --line-2: #eaecf0;
    --paper: #fff;
    --red: #b42318;
    --red-bg: #fff1f0;
    --amber: #9a6700;
  }
  .page-relatorio .no-print,
  .page-relatorio .toolbar,
  .page-relatorio .medico-dock,
  .page-relatorio .ax-top-blur,
  .page-relatorio .a4-stage,
  .page-relatorio .scenario,
  .page-relatorio .rel-sos { display: none !important; }

  /* No print: usa a fonte semântica (#doc), tipografia de documento */
  .page-relatorio.is-a4 .a4-source {
    position: static !important;
    width: auto !important; height: auto !important;
    margin: 0 !important; padding: 0 !important;
    overflow: visible !important; clip: auto !important;
    white-space: normal !important;
  }
  .page-relatorio .rel,
  .page-relatorio .document-pdf {
    width: auto;
    max-width: none;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: #fff;
  }
  .page-relatorio .rel-head,
  .page-relatorio .rel-block,
  .page-relatorio .timeline li,
  .page-relatorio .care,
  .page-relatorio .p0-banner {
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .page-relatorio .rel-head h1,
  .page-relatorio .rel-block h2,
  .page-relatorio .tl-main strong,
  .page-relatorio .care strong,
  .page-relatorio .rel-now dd { color: #101828 !important; }
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
}
